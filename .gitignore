# Root gitignore for Sonbhadra-Connect monorepo

# Node dependencies
node_modules/
jspm_packages/

# Environment variables (never commit secrets)
.env
.env.local
.env.test
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Build output
dist/
.next/
out/
build/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.suo
*.user

# Cache
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Coverage
coverage/
*.lcov
.nyc_output/
